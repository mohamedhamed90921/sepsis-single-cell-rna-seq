p_umap_group
```

# 18. Cell counts by clinical group

```{r}
group_counts <- as.data.frame(
  table(sepsis_full$group)
)

colnames(group_counts) <- c(
  "Group",
  "Number_of_Cells"
)

group_counts
```

```{r}
p_group_counts <- ggplot(
  group_counts,
  aes(
    x = reorder(
      Group,
      Number_of_Cells
    ),
    y = Number_of_Cells
  )
) +
  geom_col() +
  coord_flip() +
  labs(
    title =
      "Cell Distribution Across Clinical Groups",
    x = NULL,
    y = "Number of Cells"
  ) +
  theme_classic()

p_group_counts
```

# 19. Differential expression results

The pseudobulk differential-expression results were generated using edgeR at the biological-sample level.

```{r}
de_file <- file.path(
  base_dir,
  "DE_all_celltypes",
  "all_celltypes_edgeR_results.rds"
)

if (!file.exists(de_file)) {
  stop("Differential-expression results file not found: ", de_file)
}

all_DE_results <- readRDS(de_file)

names(all_DE_results)
```

```{r}
if (!is.null(all_DE_results[["NK"]]$results)) {
  names(all_DE_results[["NK"]]$results)
} else {
  message("NK result structure differs; inspect names(all_DE_results) above.")
}
```

# 20. GSEA results

The final GSEA results were generated from the saved differential-expression rankings using Gene Ontology Biological Process gene sets.

```{r}
gsea_results_file <- file.path(
  gsea_dir,
  "combined_GSEA_eps0.csv"
)

if (!file.exists(gsea_results_file)) {
  stop("GSEA results file not found: ", gsea_results_file)
}

gsea <- read.csv(
  gsea_results_file,
  check.names = FALSE
)

dim(gsea)
colnames(gsea)
head(gsea)
```

# 21. Significant GSEA pathways

```{r}
gsea_sig <- gsea %>%
  filter(
    !is.na(p.adjust),
    p.adjust < 0.05
  )

nrow(gsea_sig)
```

# 22. Significant pathway counts

```{r}
pathway_counts <- read.csv(
  file.path(
    fig_dir,
    "GSEA_Significant_Pathway_Counts.csv"
  )
)

aggregate(
  significant_pathways ~ comparison,
  data = pathway_counts,
  FUN = sum
)
```

# 23. Final GSEA figure

```{r}
p_gsea_counts <- ggplot(
  pathway_counts,
  aes(
    x = comparison,
    y = cell_type,
    fill = significant_pathways
  )
) +
  geom_tile(
    color = "white"
  ) +
  scale_fill_viridis_c(
    option = "C",
    name = "Significant\npathways"
  ) +
  labs(
    title =
      "Significant GSEA Pathways by Comparison",
    subtitle =
      "GO Biological Process; adjusted P value < 0.05",
    x = "Comparison",
    y = "Cell type"
  ) +
  theme_bw(base_size = 10) +
  theme(
    plot.title = element_text(
      face = "bold"
    ),
    axis.text.x = element_text(
      angle = 35,
      hjust = 1
    ),
    panel.grid = element_blank()
  )

p_gsea_counts
```

